#!/bin/sh
# Persistent per-slot RF permission. U30 defaults both on; other boards keep
# their SIM2 opt-in default. Explicit saved choices always survive an upgrade.
case ${1:-} in 0|1|--flags) ;; *) exit 2;; esac
policy=${UNISOC_RADIO_POLICY:-/etc/mu300/sim-radio}
if [ -e "$policy" ]; then
    flags=$(cat "$policy") || exit 2
else
    flags='1 0'
    [ "$(mu300-device 2>/dev/null)" != u30air ] || flags='1 1'
    [ "$(uci -q get unisoc_modem.main.data_sim 2>/dev/null)" != 1 ] || flags='1 1'
fi
case "$flags" in '0 0'|'0 1'|'1 0'|'1 1') ;; *) exit 2;; esac
[ "$1" != --flags ] || { printf '%s\n' "$flags"; exit 0; }
if [ "$1" = 0 ]; then [ "${flags% *}" = 1 ]; else [ "${flags#* }" = 1 ]; fi
