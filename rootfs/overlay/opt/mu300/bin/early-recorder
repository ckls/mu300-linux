#!/bin/sh
# Early boot recorder: for the first minutes after switch_root, copy dmesg + unit states into the persistent
# log area inside the active Linux boot partition (48 MiB, 8 MiB) every few seconds, so a power cut before journald flushes still
# leaves evidence that tools/collect-logs.sh can read from Android.
# OpenWrt: od/timeout come from the static busybox in /opt/mu300/busybox-bin
export PATH="$PATH:/opt/mu300/busybox-bin"
slot=$(cat /run/mu300/linux-slot 2>/dev/null || echo b)
case $slot in a|b) ;; *) exit 0 ;; esac
bootpart=boot_$slot
. /opt/mu300/lib/storage.sh
disk=$(mu300_storage_disk) || exit 0
node=$(mu300_storage_part "$bootpart" "$disk") || exit 0
BOOTDEV=/dev/$node
[ -b "$BOOTDEV" ] || exit 0
# --- cpus begin
# The little cluster (FINDINGS 208): a round reads the kernel's whole log, which is work that woke an A76 every few
# seconds of the boot's first minutes. This runs from preinit, before mu300-cpu puts procd's services on the little
# CPUs, so it pins itself (and what it starts): the CPUs of the lowest cpu_capacity, where taskset is there.
little_cpus() {
    _lc_min= _lc_list=
    for _c in "${MU300_CPUDIR:-/sys/devices/system/cpu}"/cpu[0-9]*; do
        _cap=; read -r _cap < "$_c/cpu_capacity" 2>/dev/null
        case $_cap in ''|*[!0-9]*) continue ;; esac
        if [ -z "$_lc_min" ] || [ "$_cap" -lt "$_lc_min" ]; then _lc_min=$_cap; _lc_list=${_c##*/cpu}
        elif [ "$_cap" = "$_lc_min" ]; then _lc_list="$_lc_list,${_c##*/cpu}"; fi
    done
    echo "$_lc_list"
}
# --- cpus end
_lc=$(little_cpus)
[ -z "$_lc" ] || taskset -pc "$_lc" $$ >/dev/null 2>&1 || true
end=$(( $(cut -d. -f1 /proc/uptime) + ${1:-300} ))
while [ "$(cut -d. -f1 /proc/uptime)" -lt "$end" ]; do
    {
        echo "MU300-PERSIST-BEGIN uptime=$(cut -d' ' -f1 /proc/uptime) (early-recorder)"
        cat /run/stages 2>/dev/null
        ip -br addr 2>/dev/null
        echo "--- lsmod"
        systemctl list-units --no-legend --plain --state=activating,failed 2>/dev/null
        [ -f /etc/openwrt_release ] && { echo "--- ps"; ps w 2>/dev/null; echo "--- logread"; logread -l 300 2>/dev/null | grep -v PR_CAPBSET; echo "--- android logcat"; tail -150 /var/log/android-logcat.txt 2>/dev/null; echo "--- mu300 logs"; tail -40 /tmp/mu300-*.log 2>/dev/null; }
        echo "--- dmesg"
        dmesg -s 1000000 2>/dev/null || dmesg | tail -c 1000000
        echo "MU300-PERSIST-END"
    } > /run/mu300-early.txt 2>&1
    head -c 65536 /dev/zero >> /run/mu300-early.txt
    # Write what there is, not the whole 8 MiB window: a fixed count=2048 put eight megabytes on the eMMC every
    # few seconds - over half a gigabyte per boot - which is flash wear, and I/O that everything else on the
    # device (the modem's NV server included) has to queue behind. The reader stops at MU300-PERSIST-END, so
    # older bytes left after it do no harm.
    blocks=$(( ($(wc -c < /run/mu300-early.txt) + 4095) / 4096 ))
    [ "$blocks" -gt 2048 ] && blocks=2048
    dd if=/run/mu300-early.txt of="$BOOTDEV" bs=4096 seek=12288 count="$blocks" conv=notrunc 2>/dev/null
    sync
    # every 2 s for the first minute and a half, where the intermittent early hangs have happened; a 10 s gap
    # left a single snapshot of a boot that died between 11 and 21 s
    if [ "$(cut -d. -f1 /proc/uptime)" -lt 90 ]; then sleep 2; else sleep 30; fi
done
