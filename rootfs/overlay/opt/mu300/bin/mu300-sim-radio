#!/bin/sh
# All RF mutations share mobile-data's radio mutex and the SIM switch gate.
# No tty opens, data-card selection or SIM power removal.
set -eu
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"
policy=${UNISOC_RADIO_POLICY:-/etc/mu300/sim-radio}
supports_dsds() { case "$(mu300-device)" in f50|u30air) return 0;; *) return 1;; esac; }
read_policy() {
    flags=$("${MU300_RADIO_ALLOWED:-/opt/mu300/bin/mu300-radio-allowed}" --flags) || {
        echo 'Invalid saved SIM radio policy' >&2; exit 1;
    }
    case "$flags" in '0 0'|'0 1'|'1 0'|'1 1') ;; *) echo 'Invalid saved SIM radio policy' >&2; exit 1;; esac
}
save_policy() {
    mkdir -p "$(dirname "$policy")"
    umask 022
    printf '%s\n' "$flags" > "$policy.new.$$"
    mv "$policy.new.$$" "$policy"
    sync -f "$policy" 2>/dev/null || true
}
case ${1:-} in
get)
    read_policy
    second=false
    [ "$(uci -q get unisoc_modem.main.sim_slots 2>/dev/null)" != 2 ] || second=true
    dsds_supported=false; dsds=false
    if supports_dsds; then
        dsds_supported=true
        [ "$("${MU300_RADIO_ALLOWED:-/opt/mu300/bin/mu300-radio-allowed}" --dsds)" != 1 ] || dsds=true
    fi
    printf '{"ok":1,"enabled":[%s,%s],"supported":[true,%s],"dsds_supported":%s,"dsds_enabled":%s}\n' "${flags% *}" "${flags#* }" "$second" "$dsds_supported" "$dsds"
    exit 0;;
dsds|--dsds-locked)
    supports_dsds || { echo dsds_unsupported >&2; exit 1; }
    case ${2:-} in 0|1) dsds=$2;; *) exit 2;; esac;;
--switch-enable)
    # Internal call from a validated data-card switch while its switch/native
    # gate is already held. RF mutations still use mobile-data's radio mutex.
    case ${2:-}:${3:-} in
        1:1) ;;
        0:1) supports_dsds || exit 2;;
        *) exit 2;;
    esac
    slot=$2; enabled=1;;
--switch-policy)
    supports_dsds || exit 2
    case ${2:-}:${3:-} in 0:0|0:1|1:0|1:1) slot=$2; enabled=$3;; *) exit 2;; esac;;
apply|--locked)
    case ${2:-}:${3:-} in 0:0|0:1|1:0|1:1) slot=$2; enabled=$3;; *) exit 2;; esac;;
*) exit 2;;
esac
if [ "$1" != --locked ] && [ "$1" != --dsds-locked ]; then
  if [ "$1" = apply ] || [ "$1" = dsds ]; then
    # Native switching uses this lock from preflight through route/boot-policy
    # completion. Share it before the RF mutex so permissions cannot change
    # halfway through that transaction or read an outdated active slot.
    if supports_dsds; then
        native_lock=${MU300_SIM_CONTROL_LOCK:-/run/mu300/sim-control.lock}
        mkdir -p "$(dirname "$native_lock")"
        exec 9>"$native_lock"
        flock -n 9 || { echo modem_busy >&2; exit 1; }
    fi
    mutex=${MU300_SIM_MUTEX:-/run/unisoc-data-sim-switch}
    mkdir "$mutex" 2>/dev/null || { echo modem_busy >&2; exit 1; }
    echo $$ > "$mutex/pid"
    trap 'rm -f "$mutex/pid"; rmdir "$mutex" 2>/dev/null || true' EXIT
    trap 'exit 143' INT TERM
    [ ! -d /run/unisoc-modem-lock-apply ] || { echo modem_busy >&2; exit 1; }
  fi
    if [ "$1" = dsds ]; then
        rc=0
        /opt/mu300/bin/mobile-data radio-dsds "$dsds" || rc=$?
        exit "$rc"
    fi
    rc=0
    /opt/mu300/bin/mobile-data radio-policy "$slot" "$enabled" || rc=$?
    if [ "$rc" = 8 ]; then
        # Release the RF mutex before invoking its existing initialization
        # path. Retain the switch gate so no other UI operation can interleave.
        # Never invent a second SFUN/SPSWDATA sequence for cold re-enablement.
        init_rc=0
        MU300_SIM_CONTROL=1 /opt/mu300/bin/mobile-data radio-on || init_rc=$?
        case "$init_rc" in 0|7) ;; *) exit "$init_rc";; esac
        /opt/mu300/bin/mobile-data radio-policy "$slot" "$enabled" || {
            echo 'Radio setting saved; target SIM is not ready' >&2; exit 1;
        }
        exit 0
    fi
    exit "$rc"
fi
if [ "$1" = --dsds-locked ]; then
    read_policy
    if [ "$dsds" = 0 ]; then
        # Keep the sole active choice, or the data SIM when both were allowed.
        case "$flags" in
            '0 1') keep=1;;
            '1 1') keep=$(uci -q get unisoc_modem.main.data_sim); [ "$keep" = 1 ] || keep=0;;
            *) keep=0;;
        esac
        sh "$0" --locked "$((1-keep))" 0 || exit 1
    else
        # Materialize the effective single-standby choice before lifting the
        # restriction, so a legacy raw "1 1" cannot spring back automatically.
        save_policy
    fi
    uci -q set "unisoc_modem.main.dual_standby=$dsds" && uci -q commit unisoc_modem || {
        uci -q revert unisoc_modem.main.dual_standby
        echo storage_failed >&2; exit 1;
    }
    exit 0
fi
if [ "$enabled" = 1 ] && supports_dsds &&
   [ "$("${MU300_RADIO_ALLOWED:-/opt/mu300/bin/mu300-radio-allowed}" --dsds)" = 0 ]; then
    # The caller already holds the switch/radio locks. Confirm peer RF
    # off before enabling this stack; a failed close must never enable both.
    sh "$0" --locked "$((1-slot))" 0 || exit 1
fi
read_policy
if [ "$slot" = 0 ]; then flags="$enabled ${flags#* }"; else flags="${flags% *} $enabled"; fi
save_policy
. /opt/mu300/bin/mu300-sim-env
mu300_sim_env
own=$MU300_SIM_SLOT
wan=$(uci -q get unisoc_modem.main.data_interface) || wan=wan
case "$wan" in ''|*[!a-zA-Z0-9_]*) exit 2;; esac
availability() { ubus -t 3 call "network.interface.$wan" notify_proto "{\"action\":5,\"available\":$1}" >/dev/null; }
if [ "$slot" = "$own" ] && [ "$enabled" = 0 ]; then availability false; fi
# Cold boot is RF-off. Do not let this UI preempt nr1's first SMMSWAP
# command with SFUN. Enabling delegates to the original initializer below;
# disabling just retains the cold RF-off state and its saved policy.
if [ ! -e "${MU300_RIL_HANDSHAKE:-/run/mu300-ril-handshake}" ]; then
    [ "$enabled" != 1 ] || exit 8
    exit 0
fi
mu300_sim_env "$slot"
at() { MU300_AT_DIR=$MU300_SIM_SHARED mu300-at -t "${2:-30}" "AT+SPACTCARD=$slot;${1#AT}" | tr -d '\r'; }
ok() { reply=$(at "$1" "${2:-30}") && [ "$(printf '%s\n' "$reply" | tail -n1)" = OK ]; }
state=$(at 'AT+CFUN?' 5 | sed -n 's/^+CFUN: *\([0124]\)$/\1/p')
case "$state" in 0|1|2|4) ;; *) echo 'Radio setting saved; RF state unavailable' >&2; exit 1;; esac
if [ "$enabled" = 1 ]; then
    if [ "$state" = 0 ]; then
        # SFUN=5 may read back as 0 while the SIM remains powered. Only an
        # actually cold SIM needs the original initialization sequence.
        pin=$(at 'AT+CPIN?' 5) || exit 1
        case "$pin" in *'+CPIN:'*) ;; *) exit 8;; esac
    fi
    if [ "$state" != 1 ]; then
        ok 'AT+SFUN=4' || { echo 'Radio setting saved; RF enable failed' >&2; exit 1; }
    fi
    expected=1
else
    ok 'AT+SFUN=5' || { echo 'Radio setting saved; RF disable failed' >&2; exit 1; }
    expected=off
fi
state=$(at 'AT+CFUN?' 5 | sed -n 's/^+CFUN: *\([0124]\)$/\1/p')
case "$expected:$state" in 1:1|off:0|off:2) ;; *) echo 'Radio setting saved; RF readback not confirmed' >&2; exit 1;; esac
if [ "$slot" = "$own" ] && [ "$enabled" = 1 ]; then availability true; fi
