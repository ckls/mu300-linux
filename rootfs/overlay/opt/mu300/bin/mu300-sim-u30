#!/bin/sh
# Legacy CLI spelling; all operations use the shared manual SIM controller.
case ${1:-status} in
    status) exec /opt/mu300/bin/mu300-data-sim get ;;
    active) cat /run/mu300-data-sim-actual ;;
    switch)
        case ${2:-} in 1) target=0;; 2) target=1;; *) exit 2;; esac
        exec /opt/mu300/bin/mu300-data-sim apply "$target" ;;
    *) echo 'Legacy automatic SIM policy removed; use SIM management and radio controls' >&2; exit 2;;
esac
