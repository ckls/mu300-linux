power: supply: bq256xx: match the stock vendor CV encoding

SSV U30Air_SSV1.0.0B14 sqc_bq2560x.ko (ce42c87c42f9...) at
sqc_mp_set_cv+0x28..+0x5c implements a plus-one register code. The
matching sqc_v8 source confirms it. The earlier round-down assumption
programmed 0x68 for a 4.3 V battery, whereas stock programs 0x70.
Quantize that board's explicit battery CV once at init; preserve generic
boards, missing-info defaults, other register bits and chip maximum.
Decode the vendor special 0xf CV value as stock does.

--- a/drivers/power/supply/bq256xx_charger.c
+++ b/drivers/power/supply/bq256xx_charger.c
@@ -637,6 +637,8 @@
 	vbatreg_reg_code = (battery_volt_lim & BQ256XX_VBATREG_MASK) >>
 						BQ256XX_VBATREG_BIT_SHIFT;
 
+	if (bq->bq2560x_chg && vbatreg_reg_code == 0xf)
+		return 4352000;
 	return (vbatreg_reg_code * BQ2560X_VBATREG_STEP_uV)
 					+ BQ2560X_VBATREG_OFFSET_uV;
 }
@@ -1937,6 +1939,27 @@
 	return 0;
 }
 
+/* Stock sqc_bq2560x.ko sqc_mp_set_cv (0x3d2c..0x3d60): the vendor
+ * encodes floor((mV - 3856) / 32) + 1, not the generic round-down path.
+ * Only use this for an explicit battery CV on the isolated vendor board.
+ */
+static int bq2560x_stock_cv(int requested, int maximum)
+{
+	unsigned int code, max_code;
+
+	if (requested < BQ2560X_VBATREG_MIN_uV)
+		return BQ2560X_VBATREG_MIN_uV;
+	max_code = (maximum - BQ2560X_VBATREG_OFFSET_uV) /
+		BQ2560X_VBATREG_STEP_uV;
+	code = (requested - BQ2560X_VBATREG_OFFSET_uV) /
+		BQ2560X_VBATREG_STEP_uV + 1;
+	code = min_t(unsigned int, code, max_code);
+	/* Code 0xf is the chip's special 4.352 V encoding. */
+	if (code == 0xf)
+		return 4352000;
+	return BQ2560X_VBATREG_OFFSET_uV + code * BQ2560X_VBATREG_STEP_uV;
+}
+
 static int bq256xx_hw_init(struct bq256xx_device *bq)
 {
 	struct power_supply_battery_info *bat_info;
@@ -2002,9 +2025,9 @@
 		 * Use this battery's declared CV, bounded by the charger capability;
 		 * fall back to the chip default only when no valid value was supplied.
 		 */
-		bq->init_data.vbatreg_max = bat_info->constant_charge_voltage_max_uv > 0 ?
-			min_t(u32, bat_info->constant_charge_voltage_max_uv,
-			      bq->chip_info->bq256xx_max_vbatreg) :
+		bq->init_data.vbatreg_max = !ret && bat_info->constant_charge_voltage_max_uv > 0 ?
+			bq2560x_stock_cv(bat_info->constant_charge_voltage_max_uv,
+					bq->chip_info->bq256xx_max_vbatreg) :
 			bq->chip_info->bq256xx_def_vbatreg;
 		/* Stock sqc_bq2560x probe clears REG05 EN_TIMER (0x1b08).
 		 * Keep termination enabled; this does not disable TS/NTC protection.
