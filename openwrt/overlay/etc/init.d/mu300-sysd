#!/bin/sh /etc/rc.common
# Common keys, LED deadline checks and thermal guard; original helpers retain policy.
START=95
USE_PROCD=1
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin"
start_service() {
    /usr/bin/ucode /opt/mu300/bin/mu300-sysd --check || return 1
    procd_open_instance sysd
    procd_set_param command /usr/bin/ucode /opt/mu300/bin/mu300-sysd
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
